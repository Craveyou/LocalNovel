<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F6F7F4</item>
        <item name="android:colorAccent">#1A685B</item>
    </style>
    <style name="XlibDialogLight" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1A685B</item>
        <item name="android:colorControlActivated">#1A685B</item>
        <item name="android:colorBackground">#FFFFFC</item>
        <item name="android:textColorPrimary">#1C1F1D</item>
        <item name="android:textColorSecondary">#636B66</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="XlibDialogDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#89D8C5</item>
        <item name="android:colorControlActivated">#89D8C5</item>
        <item name="android:colorBackground">#1C201E</item>
        <item name="android:textColorPrimary">#EDF1ED</item>
        <item name="android:textColorSecondary">#AEB7B2</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
